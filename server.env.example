# Copy these values into the server's environment configuration.
# On Windows PowerShell, for example:
#   $env:SEC_APP_HOST = "0.0.0.0"
#   $env:SEC_APP_PORT = "5000"

SEC_APP_HOST=0.0.0.0
SEC_APP_PORT=5000
SEC_APP_DEBUG=false
SEC_APP_HTTPS=false
SEC_APP_MAX_UPLOAD_MB=25
# Production database. Keep the password in the server secret store, never in this file.
SEC_APP_DATABASE_ENGINE=mssql
SEC_APP_DB_SERVER=192.168.240.22
SEC_APP_DB_PORT=1433
SEC_APP_DB_DATABASE=SEC_PORTAL
SEC_APP_DB_UID=sec_app_runtime
SEC_APP_DB_PASSWORD=replace-with-a-strong-secret
# SQLite rollback snapshot. Use an absolute path when deployed as a Windows service.
SEC_APP_SQLITE_PATH=C:\Sec_App\instance\sec_app.sqlite3
# Login session expires after 1 minute without activity.
# Recommended for managed/production deployments. Generate once with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep the generated value in the server secret store/environment; never commit it.
# If omitted, SEC_APP creates a persistent random secret in the project root.
SEC_APP_SECRET_KEY=replace-with-a-unique-random-secret
